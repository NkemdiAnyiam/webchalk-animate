{
  "compilerOptions": {
    "target": "ES2024",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "stripInternal": true,
    "noEmit": true,
    "noErrorTruncation": true,
    "types": ["node"],
    "allowJs": true
  },
  "exclude": ["node_modules", "**/__tests__/*"]
}
